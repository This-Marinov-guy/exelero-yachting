# Use a separate Supabase test project with the checked-in migrations applied.
# Keep the real values in Git-ignored .env.form-test.local.
FORM_TEST_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
FORM_TEST_SUPABASE_URL=https://PROJECT_REF.supabase.co
FORM_TEST_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY
FORM_TEST_USER_ID=00000000-0000-4000-8000-000000000000
# Only for an intentional test against the project's existing linked database:
# FORM_TEST_ALLOW_LINKED_PROJECT=yes
