{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/loading.js"
    ],
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/not-found.js"
    ],
    "/(mainBody)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(mainBody)/layout.js"
    ],
    "/(mainBody)/partners/[partnerId]/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(mainBody)/partners/[partnerId]/loading.css",
      "static/chunks/app/(mainBody)/partners/[partnerId]/loading.js"
    ],
    "/(mainBody)/partners/[partnerId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(mainBody)/partners/[partnerId]/page.css",
      "static/chunks/app/(mainBody)/partners/[partnerId]/page.js"
    ],
    "/(mainBody)/new-yachts/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(mainBody)/new-yachts/page.js"
    ]
  }
}