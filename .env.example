# Required for listings, accounts, and forms.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: saving boat/partner inquiries and recording email delivery.
# Prefer a current sb_secret_ key. The legacy service-role key remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only fallback for hosts that connect through Supabase's transaction pooler.
SUPABASE_DB_URL=

# Sitemap refresh endpoint; use the same secret in the GitHub Action.
SITEMAP_REVALIDATE_TOKEN=

# Local canonical URL. Production builds use https://www.exeleroyachting.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: production Microsoft Clarity project. Analytics still requires visitor consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=vekv1ut2zw

# Server-only Clarity Data Export token for the rolling 72-hour experience report.
# Generate in the same project's Settings > Data Export. Never use NEXT_PUBLIC_.
CLARITY_API_TOKEN=

# Form notification email settings.
GMAIL_HOST=
GMAIL_PORT=
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_ENCRYPTION=
GMAIL_FROM_ADDRESS=
GMAIL_FROM_NAME=
# JSON array of addresses that receive every form notification.
NOTIFICATION_TO_EMAIL='["kbnaumov@gmail.com","vladislavmarinov3142@gmail.com"]'

# Server-only reporting for the account Tracking section.
# Public GA4 web stream measurement ID (G-...), used only after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Must match the GA4 property timezone; Search Console uses Pacific time.
ANALYTICS_TIME_ZONE=Europe/Amsterdam
ANALYTICS_HOSTNAMES=exeleroyachting.com,www.exeleroyachting.com
