# Required for listings, accounts, and forms.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local canonical URL. Production builds use https://www.exeleroyachting.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Optional: production Microsoft Clarity project. Analytics still requires visitor consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=vekv1ut2zw

# Optional: contact/notification email.
GMAIL_HOST=
GMAIL_PORT=
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_ENCRYPTION=
GMAIL_FROM_ADDRESS=
GMAIL_FROM_NAME=
NOTIFICATION_TO_EMAIL=
